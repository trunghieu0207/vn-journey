# Sao chép thành .env rồi chỉnh. KHÔNG commit file .env.
HOST=127.0.0.1
PORT=3000
DB_PATH=./var/game.db
BACKUP_INTERVAL_MIN=5

# true khi chạy trên host có HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:3000
# true khi chạy sau Nginx (Nginx đặt X-Real-IP); KHÔNG bật nếu Node mở thẳng ra mạng
TRUST_PROXY=false

# Thời lượng mặc định khi chủ phòng không chọn (phút)
GAME_DURATION_MIN=45
FREEZE_BEFORE_END_MIN=10

# (không bắt buộc) Khóa mã hóa mã chủ phòng cho trang quản trị — 64 ký tự hex (openssl rand -hex 32).
# Bỏ trống thì server tự tạo var/secret.key lần chạy đầu.
# SECRET_KEY=
